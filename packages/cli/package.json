{
  "name": "@ectype/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Ectype migration runner and generators (placeholder until step 18).",
  "license": "MIT",
  "author": "Casey Tickes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caseyt/ectype-orm.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/caseyt/ectype-orm#readme",
  "bugs": "https://github.com/caseyt/ectype-orm/issues",
  "keywords": [
    "orm",
    "ecto",
    "typescript",
    "sql",
    "changeset",
    "query-builder"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "lint:package": "publint --strict && attw --pack ."
  },
  "peerDependencies": {
    "ectype": "workspace:^"
  },
  "devDependencies": {
    "ectype": "workspace:*"
  }
}
